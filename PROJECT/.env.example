APP_NAME="QUDRIX Travel CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=qudrix_travel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=api-mt1.pusher.com
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"

JWT_SECRET=
JWT_ALGORITHM=HS256

# Comma-separated, no wildcard: the API refuses every cross-origin
# request until this lists your actual frontend origin(s), e.g.
# CORS_ALLOWED_ORIGINS=https://app.qudrix.com
# For local frontend dev against `php artisan serve`, typically:
# CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000
SANCTUM_DOMAIN=

# Admin URL segment (Phase 0). Change this to move the admin path without
# touching route/auth/RBAC code.
ADMIN_URL_PATH=admin

# Multi-language (Phase 0 scaffold)
DEFAULT_LOCALE=en

# AI Provider Manager (Phase 0 scaffold — Phase 9 wires actual provider
# calls). Do NOT put real API keys in this example file; configure per-tenant
# credentials via the ai_providers table (encrypted) once the admin UI for
# it exists.
AI_DEFAULT_PROVIDER=
AI_GLOBAL_MONTHLY_COST_CEILING_USD=500

# Telegram notifications (Phase 7). Server-side only.
TELEGRAM_BOT_TOKEN=

# Integration Manager / custom API connectors (Phase 8).
# Operator-configured connectors call arbitrary URLs; allowing private or
# loopback addresses turns that into an SSRF vector against the host's own
# network, so it is refused unless you deliberately enable it.
ALLOW_PRIVATE_NETWORK_CONNECTORS=false
CONNECTOR_MAX_TIMEOUT_SECONDS=60
CONNECTOR_MAX_LOGGED_RESPONSE_BYTES=65536

# Security (Phase 15)
RATE_LIMIT_AUTHENTICATED=100
RATE_LIMIT_GUEST=30
RATE_LIMIT_LOGIN=5
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
ACCESS_LOG_ENABLED=true
ACCESS_LOG_SLOW_MS=3000

# HRM (Phase 16)
HRM_WORK_START_TIME=09:30
HRM_WORK_END_TIME=18:00
